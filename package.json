{
  "name": "froggle",
  "private": true,
  "workspaces": [
    "models",
    "engine",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently 'npm run dev:server' 'npm run dev:client'",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "backfill:daily": "tsx scripts/backfillDailyAggregates.ts",
    "rescore:results": "tsx scripts/rescoreResults.ts",
    "email:daily-summary": "tsx scripts/sendDailySummary.ts",
    "calibrate-letters": "tsx scripts/calibrate-letters.ts",
    "tune-quotas": "tsx scripts/tune-quotas.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "playwright test",
    "check": "npm run check:boundaries && npm exec --workspace=client -- tsc --noEmit && npm exec --workspace=server -- tsc --noEmit && npm exec --workspace=engine -- tsc --noEmit && npm exec --workspace=models -- tsc --noEmit && tsc --project tests/browser/tsconfig.json",
    "check:boundaries": "node scripts/checkBoundaries.mjs",
    "verify:visual": "node --import tsx scripts/compareExperience.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testcontainers/postgresql": "^12.0.2",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "testcontainers": "^12.0.2",
    "vitest": "^4.1.5"
  }
}
